# Copier en .env puis renseigner les valeurs. Ne jamais commiter le fichier .env (CDC RG07, CR06).

APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://actes:actes@localhost:5432/actes
# Origines autorisées pour l'application cliente (format JSON)
CORS_ORIGINS=["http://localhost:5173"]

# Authentification des agents — 32 caractères minimum (ex. : python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_HOURS=8

# Compte administrateur créé au premier démarrage
ADMIN_IDENTIFIANT=admin
ADMIN_MOT_DE_PASSE=
ADMIN_NOM=Administrateur

# RM09 : l'instructeur d'un dossier ne peut pas le décider
SEPARATION_INSTRUCTION_DECISION=true

# Intégration Pipedrive (ISD-001 §2.1)
PIPEDRIVE_BASE_URL=https://api.pipedrive.com
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_PIPELINE_NAME=Actes administratifs
PIPEDRIVE_OWNER_ID=
PIPEDRIVE_CONNECT_TIMEOUT=3
PIPEDRIVE_READ_TIMEOUT=10
PIPEDRIVE_MAX_RETRIES=5

# Worker de synchronisation : processus séparé (recommandé) ou embarqué dans l'API (démo)
SYNC_POLL_INTERVAL=5
SYNC_WORKER_EMBARQUE=false

# Application web des agents (Flask) — lancée avec : uv run flask --app web.app run --port 5000
WEB_API_URL=http://127.0.0.1:8000/api/v1
# Clé de signature du cookie de session (ex. : python -c "import secrets; print(secrets.token_urlsafe(48))")
WEB_SECRET_KEY=
WEB_SESSIONS_DIR=instance/sessions
# true si l'application est servie en HTTPS
WEB_COOKIE_SECURE=false
